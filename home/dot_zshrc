eval "$(/opt/homebrew/bin/brew shellenv)"

# Oh My Zsh and the third-party plugins in $ZSH_CUSTOM are cloned and
# updated weekly by chezmoi (see .chezmoiexternal.toml).
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode disabled
# The mise plugin also runs `mise activate zsh` (versions in ~/.config/mise/config.toml).
# zsh-syntax-highlighting must stay last.
plugins=(git kubectl kube-ps1 docker argocd gh mise terraform helm tmux zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# Current k8s context and namespace in the prompt
PROMPT='$(kube_ps1) '$PROMPT

export PATH="$HOME/.local/bin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="$PATH:$HOME/go/bin"

alias assume="source assume"
alias python="python3"

export ENABLE_LSP_TOOL=1
